{
  "version": 1,
  "hooks": {
    "stop": [
      { "command": ".cursor/hooks/check-cf-node.sh" },
      { "command": ".cursor/hooks/check-web-src.sh" }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/check-web-src.sh",
        "matcher": "git commit"
      }
    ]
  }
}
