---
import "../styles/global.css";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "../lib/og/constants";
import { siteDescription, siteName } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedAt?: Date;
  ogImage?: { url: URL; alt: string };
}

const { title, description = siteDescription, ogType = "website", publishedAt, ogImage } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const ogTitle = title ?? siteName;
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(pathname, Astro.site);
const feedUrl = new URL("/feed.xml", Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={feedUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="ja_JP" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage.url.href} />
        <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={ogImage.alt} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage.url.href} />}
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white" data-pagefind-ignore>
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="text-xl font-bold tracking-tight">{siteName}</a>
        <form action="/search" method="get" role="search">
          <input
            type="search"
            name="q"
            aria-label="記事を検索"
            placeholder="検索"
            maxlength="100"
            class="w-40 rounded border border-slate-300 px-3 py-1 text-sm sm:w-56"
          />
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>
