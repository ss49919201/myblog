---
import { render } from "astro:content";
import CategoryLink from "../../components/CategoryLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { descriptionFromMarkdown } from "../../lib/description";
import { formatDate } from "../../lib/format";
import { postOgImageUrl } from "../../lib/og/urls";
import { categoryOf, publishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug } }));
}

const slug = Astro.params.slug;
const post = (await publishedPosts()).find((entry) => entry.data.slug === slug);
if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

const category = await categoryOf(post);
const description = descriptionFromMarkdown(post.body ?? "") || post.data.title;
const ogImage = { url: postOgImageUrl(post.data.slug, Astro.site), alt: post.data.title };
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogType="article"
  publishedAt={post.data.date}
  ogImage={ogImage}
>
  <article data-pagefind-body>
    <div class="flex items-center gap-3">
      <time class="text-sm text-slate-500" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <CategoryLink category={category} />
    </div>
    <h1 class="mt-1 text-3xl font-bold">{post.data.title}</h1>
    <div class="prose prose-slate mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
