---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteOgImageUrl } from "../lib/og/urls";
import { siteName } from "../lib/site";

const description = "記事のタイトルと本文を検索します。";
const ogImage = { url: siteOgImageUrl(Astro.site), alt: siteName };
---

<BaseLayout title="検索" description={description} ogImage={ogImage}>
  <h1 class="text-3xl font-bold">検索</h1>
  <div class="mt-6" data-pagefind-ignore>
    <pagefind-config bundle-path="/pagefind/" lang="ja"></pagefind-config>
    <pagefind-input placeholder="タイトル・本文から検索"></pagefind-input>
    <pagefind-summary default-message="キーワードを入力してください。"></pagefind-summary>
    <pagefind-results></pagefind-results>
    <noscript>
      <p class="mt-6 text-slate-500">検索には JavaScript が必要です。</p>
    </noscript>
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <script is:inline type="module">
      const params = new URLSearchParams(window.location.search);
      const query = params.get("q")?.trim().slice(0, 100) ?? "";
      if (query) {
        window.PagefindComponents.getInstanceManager().getInstance("default").triggerSearch(query);
      }
    </script>
  </div>
</BaseLayout>
