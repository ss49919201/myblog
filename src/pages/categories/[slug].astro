---
import { getCollection, getEntry } from "astro:content";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  return categories.map((category) => ({ params: { slug: category.id } }));
}

const slug = Astro.params.slug;
if (!slug) {
  throw new Error("Missing category slug");
}

const category = await getEntry("categories", slug);
if (!category) {
  throw new Error(`Category not found: ${slug}`);
}

const posts = (await publishedPosts()).filter((post) => post.data.category?.id === category.id);
const description = `${category.data.name}の記事`;
---

<BaseLayout title={category.data.name} description={description}>
  <section>
    <p class="text-sm text-slate-500">カテゴリー</p>
    <h1 class="mt-1 mb-8 text-3xl font-bold">{category.data.name}</h1>
    <PostList posts={posts} />
  </section>
</BaseLayout>
