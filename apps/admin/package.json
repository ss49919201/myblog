{
  "name": "@myblog/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-test-jwks.mjs",
    "test": "vitest run",
    "db:local:touch": "wrangler d1 execute myblog-web --local --command \"SELECT 1\"",
    "db:local:plan": "wrangler d1 export myblog-web --local --no-data --output /tmp/myblog-web-local-current.sql && sqlite3def /tmp/myblog-web-local-current.sql -f ../web/schema.sql --dry-run",
    "db:local:apply": "wrangler d1 export myblog-web --local --no-data --output /tmp/myblog-web-local-current.sql && sqlite3def /tmp/myblog-web-local-current.sql -f ../web/schema.sql --dry-run | grep -vE '^(-- dry run --|BEGIN;|COMMIT;)$' > /tmp/myblog-web-local-migrate.sql && if [ -s /tmp/myblog-web-local-migrate.sql ]; then wrangler d1 execute myblog-web --local --file /tmp/myblog-web-local-migrate.sql; else echo 'schema already matches'; fi",
    "db:schema:check": "rm -f /tmp/myblog-admin-schema-check.sqlite && sqlite3def /tmp/myblog-admin-schema-check.sqlite --apply -f ../web/schema.sql && sqlite3def /tmp/myblog-admin-schema-check.sqlite -f ../web/schema.sql --check"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.1.0",
    "marked": "15.0.12",
    "neverthrow": "8.2.0",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "22.15.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "sqldefVersion": "v3.11.26"
}
