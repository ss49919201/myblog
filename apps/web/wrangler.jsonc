{
  // Used only by `npx wrangler d1 export` (not supported by `cf`). Keep `database_id` in sync with `cloudflare.config.ts`.
  "name": "myblog-web",
  "compatibility_date": "2026-10-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myblog-web",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID"
    }
  ]
}
