<!doctype html>
<html lang="ja"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blog CMS</title>
<style>
body{font:16px system-ui,sans-serif;max-width:1000px;margin:2rem auto;padding:0 1rem;color:#222}
main{display:grid;grid-template-columns:220px 1fr;gap:2rem}aside a{display:block;margin:.5rem 0;overflow-wrap:anywhere}
label{display:block;margin:1rem 0 .3rem}input,textarea{box-sizing:border-box;width:100%;font:inherit;padding:.6rem}
textarea{min-height:60vh;font-family:ui-monospace,monospace}button{font:inherit;padding:.6rem 1.2rem;margin-top:1rem}
@media(max-width:650px){main{display:block}textarea{min-height:50vh}}
</style>
<h1>Blog CMS</h1><main><aside><a href="/">新規記事</a><h2>記事</h2>
{{range .Posts}}<a href="/?filename={{.Filename | urlquery}}">{{if .Title}}{{.Title}}{{else}}{{.Filename}}{{end}}</a>{{end}}</aside>
<section>{{if .Saved}}<p role="status">保存しました</p>{{end}}
<form method="post" action="/"><input type="hidden" name="filename" value="{{.Current.Filename}}">
<label for="title">タイトル</label><input id="title" name="title" value="{{.Current.Title}}" required>
<label for="markdown">Markdown</label><textarea id="markdown" name="markdown" required>{{.Current.Markdown}}</textarea>
<button type="submit">保存</button></form></section></main></html>
